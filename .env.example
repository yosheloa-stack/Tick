# Token do bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# ID da aplicacao (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID do servidor onde os comandos serao registrados.
# Deixe vazio para registrar os comandos globalmente (propagacao mais lenta).
GUILD_ID=

# Nivel de log: error | warn | info | debug
LOG_LEVEL=info
